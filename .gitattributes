# Normalize line endings in the repo regardless of contributor OS.
* text=auto

# Source files: always LF (prevents CRLF noise on Windows).
*.js  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sh  text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
