    "test:l3": "node test/l3.test.js",
    "test:dhcp": "node test/dhcp.test.js",
    "test:nat": "node test/nat.test.js",
    "test:acl": "node test/acl.test.js",
    "test:acl-data": "node test/acl-data.test.js",
    "test:vrrp": "node test/vrrp.test.js",
    "test:ospf": "node test/ospf.test.js",
