  "G_nat_runs_before_routing": {
    "probe": {
      "rule": "pat 192.168.1.0/24 -> 203.0.113.2 (the wan1 address)",
      "translations": [],
      "note": "NAT picks the rule's insideGlobal, not the egress interface address; a secondary-WAN flow is translated to the primary WAN address"
    },
    "code_evidence": "_forwardL3() calls _natOutbound() (~1898) BEFORE dev.routeTo() (~1904), so NAT cannot know the egress WAN; nat.js translateOutbound(table, pkt, step) takes no interface argument",
    "icmp_note": "ping/ICMP carries no l4 header, so _natOutbound returns 'pass' at the !frame.l4 guard; the ordering, not a trace, is the evidence"
  },
