    },
    "primary_nexthop_unplugged": {
      "label": "identical, but ispA has no IP (cable in, nothing answering)",
      "pingSuccess": false,
      "egressFromEdge": [
        "lan1",
        "wan1"
      ],
      "routeEvents": [
        "wan1 via 203.0.113.1"
      ],
      "arp": [
        "eth0 -> 192.168.1.1",
        "wan1 -> 203.0.113.1"
      ],
      "drops": [],
      "outcomes": [
        "arp-reply"
      ]
    },
    "verdict": [
      "Link.state='down' changes nothing: the trace is identical to case 1 because neither _deliver() nor _forwardL3() consults Link.isUp()",
      "disabling the interface does NOT fail over: the packet dies with 'no usable egress interface' while a valid second default sits in config.routes",
      "an unplugged next hop is silence (ARP never answered), never a switch to the other default"
    ]
  },
