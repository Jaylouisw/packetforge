  "howToReproduce": {
    "engine_entry": "require('./engine').{Topology,Simulator}",
    "steps": [
      "new Topology(); addDevice(spec, id) with the shipped devices/generic/generic-cloud.json and devices/peplink/max-br1-pro-5g.json",
      "topo.validateLink(aDev, aIface, bDev, bIface, {}) -> verdict {ok, errors:[{code,message}], media, mediaId, speedMbps}",
      "assign interface.ip/mask by hand, push config.routes, then new Simulator(topo).ping(srcId, dstIp, {count:1})",
      "read only the span after the last {type:'ping'} event: LLDP and RA announcements run before it"
    ],
    "gotcha": "ping success depends on the far end having a route back; the egress-port list, not success, is the signal for route selection"
  },
