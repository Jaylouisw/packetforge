  "fabric": {
    "capacityMbps": 240000,
    "kind": "switching fabric",
    "note": "Vendor 240 Gbps non-blocking fabric across 48 ports (40 x 1G + 8 x 10G = 120 Gbit/s each way); forwarding rate 178.56 Mpps, line rate."
  },
  "poe": {
    "budgetW": 960,
    "sourceUrl": "https://www.downloads.netgear.com/files/GDC/M4250/M4250_Datasheet.pdf",
    "note": "960 W across 40 PoE+ ports (24 W per port on average), double the M4250-40G8F-PoE+ budget on the same copper block - the difference buys 10G uplinks and the supply capacity behind them."
  },
  "notes": "M4250 series common platform: 16K MAC addresses, 4K ARP/NDP entries, 4K VLANs, static routes (894 IPv4 / 126 IPv6) plus RIP (32 IPv4), DHCP server (2K leases), sFlow, SNMP, console/telnet/SSH CLI and the AV web GUI. The 10G-uplink 40-port member: 40 PoE+ copper ports and 8 x 1G/10G SFP+, 240 Gbps fabric against the 96 Gbps of the 1G-SFP M4250-40G8F-PoE+. Packet buffer 32 MB. Sources: datasheet https://www.downloads.netgear.com/files/GDC/M4250/M4250_Datasheet.pdf and https://kb.netgear.com/000064904/NETGEAR-AV-Line-of-Fully-Managed-Switches-M4250-Series."
